# Bitrix24 inbound webhook (crm.lead.add permission), e.g.
# https://your-portal.bitrix24.kz/rest/1/xxxxxxxxxxxxxxxx/
#
# On this project's actual hosting (static export served by nginx on Plesk,
# no Node runtime) an env var here has no effect at runtime — public/api/lead.php
# reads it from a file outside httpdocs instead. See secrets/b24-webhook.php.example.
# This variable is kept here for local/dev reference and for any future
# Node-capable deployment where public/api/lead.php's getenv() call would apply.
B24_WEBHOOK_URL=
